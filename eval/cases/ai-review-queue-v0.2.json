{
  "id": "ai-review-queue-v0.2",
  "title": "Use case 3 — AI draft review queue",
  "mode": "guided",
  "prompt": "Build an internal UI for reviewing AI-drafted support replies before they send. Queue shows pending drafts with confidence, model, and source ticket. Reviewer approves or rejects from the detail screen.",
  "mockApi": {
    "endpoints": [
      {
        "method": "GET",
        "path": "/api/drafts",
        "description": "Draft inbox list; browse binding valuePath items"
      },
      {
        "method": "GET",
        "path": "/api/drafts/{draftId}",
        "description": "Draft detail for read screen"
      },
      {
        "method": "POST",
        "path": "/api/drafts/{draftId}/approve",
        "description": "Approve embedded act on detail"
      },
      {
        "method": "POST",
        "path": "/api/drafts/{draftId}/reject",
        "description": "Reject embedded act on detail"
      }
    ]
  },
  "conversationScript": [
    {
      "trigger": "after_agent_reply",
      "content": "Approve and reject must be embedded actions on the detail screen, not row actions. Status filter on the inbox table."
    },
    {
      "trigger": "after_agent_reply",
      "content": "Yes, build it."
    }
  ],
  "successCriteria": {
    "mustValidate": true,
    "maxRetries": 5,
    "maxUserTurns": 4,
    "assertions": [
      { "id": "uc3-browse", "kind": "operationCount", "type": "browse", "minCount": 1 },
      { "id": "uc3-read", "kind": "operationCount", "type": "read", "minCount": 1 },
      { "id": "uc3-act-on-detail", "kind": "embeddedAction", "type": "act", "hostOperationType": "read", "minCount": 2 },
      { "id": "uc3-transition-row", "kind": "transitionTriggers", "triggers": ["row"] },
      { "id": "uc3-path-inbox", "kind": "dataPath", "method": "GET", "path": "/api/drafts" },
      { "id": "uc3-path-detail", "kind": "dataPath", "method": "GET", "path": "/api/drafts/{draftId}" },
      { "id": "uc3-path-approve", "kind": "dataPath", "method": "POST", "path": "/api/drafts/{draftId}/approve" },
      { "id": "uc3-path-reject", "kind": "dataPath", "method": "POST", "path": "/api/drafts/{draftId}/reject" }
    ]
  }
}
