# Platform (Vercel / local Next.js)
DATABASE_URL=           # Neon Postgres pooled connection string (fresh v0.2 database)
RAPIDUI_BASE_URL=       # Canonical public URL (e.g. https://rapidui.dev) — set in Vercel production
NEXT_PUBLIC_RAPIDUI_AGENT_URL=http://localhost:8000/chat  # Main UI chat transport (Phase 5)

# RapidUI Agent (Render — Phase 4)
OPENAI_API_KEY=
RAPIDUI_BASE_URL=http://localhost:3000
LOGFIRE_TOKEN=          # Logfire write token (agent/.env or Render) — optional O2
# RAPIDUI_AGENT_MODEL=openai:o4-mini
# RAPIDUI_AGENT_PROMPT_VERSION=v1
# RAPIDUI_ENV=local
