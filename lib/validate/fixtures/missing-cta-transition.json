{
  "version": "0.2",
  "app": { "title": "Missing CTA" },
  "entities": [
    {
      "id": "ent-items",
      "label": "Items",
      "entrypoints": ["op-browse-items"],
      "operationIds": ["op-browse-items", "op-create-item", "op-read-item"]
    }
  ],
  "operations": [
    {
      "id": "op-browse-items",
      "entityId": "ent-items",
      "type": "browse",
      "title": "Items",
      "route": "/items",
      "presentation": {
        "layout": "table",
        "columns": [{ "key": "id", "label": "ID" }]
      },
      "data": {
        "mode": "static",
        "records": [{ "id": "1" }]
      }
    },
    {
      "id": "op-read-item",
      "entityId": "ent-items",
      "type": "read",
      "title": "Item",
      "route": "/items/{itemId}",
      "params": ["itemId"],
      "presentation": {
        "layout": "detail",
        "sections": [{ "title": "Item", "fields": [{ "key": "id", "label": "ID" }] }]
      },
      "data": {
        "mode": "static",
        "records": [{ "id": "1" }]
      }
    },
    {
      "id": "op-create-item",
      "entityId": "ent-items",
      "type": "create",
      "title": "Create item",
      "route": "/items/new",
      "presentation": {
        "layout": "form",
        "fields": [{ "name": "name", "label": "Name", "type": "text", "required": true }]
      },
      "data": {
        "mode": "static",
        "records": [{ "name": "Example" }]
      },
      "outcomes": {
        "success": { "navigate": "op-browse-items" },
        "error": { "stay": true },
        "cancel": { "navigate": "op-browse-items" }
      }
    }
  ],
  "transitions": [
    {
      "from": "op-browse-items",
      "to": "op-read-item",
      "trigger": "row",
      "map": { "itemId": "id" }
    }
  ]
}
