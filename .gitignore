# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.venv/
agent/.venv/
agent/**/__pycache__/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore secrets; keep *.example templates tracked
.env
.env.local
.env*.local
agent/.env
!.env.example
!agent/.env.example

# typescript (generated — do not commit tsbuildinfo)
*.tsbuildinfo

# vercel
.vercel
