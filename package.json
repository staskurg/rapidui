{
  "name": "rapid-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke:operations": "tsx scripts/smoke-operations.ts",
    "smoke:validate": "tsx scripts/smoke-validate.ts",
    "smoke:docs": "tsx scripts/smoke-docs.ts",
    "smoke:specs": "tsx --env-file=.env.local scripts/smoke-specs.ts",
    "smoke:inspector": "tsx scripts/smoke-inspector.ts",
    "smoke:eval": "tsx --env-file=.env.local scripts/smoke-eval.ts",
    "smoke:observe": "tsx --env-file=.env.local scripts/smoke-observe.ts",
    "smoke:observe-api": "tsx --env-file=.env.local scripts/smoke-observe-api.ts",
    "smoke:observe-discovery": "tsx --env-file=.env.local scripts/smoke-observe-discovery.ts",
    "smoke:agent": "cd agent && .venv/bin/python scripts/smoke_chat.py",
    "chat:agent": "cd agent && .venv/bin/python scripts/chat_cli.py",
    "eval:prompt": "tsx scripts/render-eval-prompt.ts",
    "eval:score": "tsx --env-file=.env.local eval/score.ts",
    "eval:log": "tsx --env-file=.env.local scripts/log-eval-run.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
